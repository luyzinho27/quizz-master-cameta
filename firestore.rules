rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return currentUserExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }

    function isProfessor() {
      return currentUserExists() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'professor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'prof'
      );
    }

    function isStudent() {
      return currentUserExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'aluno';
    }

    function isAdminOrProfessor() {
      return isAdmin() || isProfessor();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidUserType(userType) {
      return userType == 'aluno' || userType == 'professor' || userType == 'prof' || userType == 'admin';
    }

    function isStudentUserData(data) {
      return data.userType == 'aluno';
    }

    function ownsExistingResource() {
      return resource.data.ownerId == request.auth.uid || resource.data.teacherId == request.auth.uid;
    }

    function ownsRequestedResource() {
      return request.resource.data.ownerId == request.auth.uid || request.resource.data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn() && (
        isSelf(userId) ||
        isAdmin() ||
        (isProfessor() && isStudentUserData(resource.data))
      );

      allow list: if isAdmin() || (isProfessor() && isStudentUserData(resource.data));

      allow create: if signedIn() && (
        (isSelf(userId) && isValidUserType(request.resource.data.userType)) ||
        (isAdmin() && isValidUserType(request.resource.data.userType)) ||
        (isProfessor() && isStudentUserData(request.resource.data))
      );

      allow update: if signedIn() && (
        (isSelf(userId) && request.resource.data.userType == resource.data.userType) ||
        isAdmin() ||
        (isProfessor() && isStudentUserData(resource.data) && isStudentUserData(request.resource.data))
      );

      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      // Read access: admins, owners, or members of the room
      // Allow any authenticated user to read rooms. This is necessary so that
      // students can retrieve a room document before adding themselves via
      // arrayUnion. The room data is not sensitive, so this permissive rule
      // keeps the logic simple.
      allow get, list: if signedIn();

      // Creation: admins or professors who own the resource
      allow create: if signedIn() && (
        isAdminOrProfessor() &&
        ownsRequestedResource()
      );

      // Update: admins/professors who own the resource, or any authenticated user
      // who is adding themselves to the room (i.e., their UID appears in the
      // updated studentIds array). This allows students to join rooms via a
      // link without requiring a Cloud Function.
      allow update: if signedIn() && (
        isAdminOrProfessor() &&
        ownsExistingResource() &&
        ownsRequestedResource()
      ) || (
        request.auth.uid in request.resource.data.studentIds
      );

      // Deletion: admins or professors who own the resource
      allow delete: if signedIn() && (
        isAdminOrProfessor() &&
        ownsExistingResource()
      );
    }

    match /quizzes/{quizId} {
      allow read: if signedIn() && (
        isAdmin() ||
        ownsExistingResource() ||
        (isStudent() && resource.data.status == 'active')
      );

      allow create: if signedIn() && (
        (isAdmin() && ownsRequestedResource()) ||
        (isProfessor() && request.resource.data.visibility == 'room' && ownsRequestedResource())
      );

      allow update: if signedIn() && (
        (isAdmin() && ownsExistingResource() && ownsRequestedResource()) ||
        (
          isProfessor() &&
          resource.data.visibility == 'room' &&
          request.resource.data.visibility == 'room' &&
          ownsExistingResource() &&
          ownsRequestedResource()
        )
      );

      allow delete: if signedIn() && (
        (isAdmin() && ownsExistingResource()) ||
        (isProfessor() && resource.data.visibility == 'room' && ownsExistingResource())
      );
    }

    match /questions/{questionId} {
      allow read: if signedIn();

      allow create: if signedIn() && (
        isAdmin() ||
        (isProfessor() && ownsRequestedResource())
      );

      allow update: if signedIn() && (
        isAdmin() ||
        (
          isProfessor() &&
          ownsExistingResource() &&
          ownsRequestedResource()
        )
      );

      allow delete: if signedIn() && (
        isAdmin() ||
        (isProfessor() && ownsExistingResource())
      );
    }

    match /userQuizzes/{userQuizId} {
      allow read: if signedIn() && (
        isAdminOrProfessor() ||
        resource.data.userId == request.auth.uid ||
        resource.data.status == 'completed'
      );

      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'in-progress'
        )
      );

      allow update: if signedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          resource.data.status != 'completed'
        )
      );

      allow delete: if signedIn() && (
        isAdmin()
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
